@startuml c4-components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Componentes — Aí 'Se Cream (C4 Nível 3)

Person(admin, "Administrador", "Acesso total: CRUD de sabores, lojas, lotes, operadores; cancelar distribuições.")
Person(operador, "Operador de Produção", "Visualiza módulos (exceto operadores). Cria distribuições e baixas.")

ContainerDb(db, "Banco de Dados", "MariaDB", "Armazena todos os dados do sistema. Schema versionado pelo Flyway.")

Container_Boundary(web, "Aplicação Web — Java 21 · Spring Boot 4 · Spring MVC") {

    ' ─── Segurança ───────────────────────────────────────────────
    Component(securityConfig,   "SecurityConfig",         "Spring Security · @Configuration", "Rotas públicas, RBAC por perfil e página de acesso negado.")
    Component(jwtFilter,        "JwtAuthFilter",          "OncePerRequestFilter",              "Valida JWT do cookie e carrega o contexto de segurança.")
    Component(jwtService,       "JwtService",             "Componente Spring",                 "Gera, assina e valida tokens JWT.")
    Component(authController,   "AuthController",         "REST · /auth/login",                "Login JSON: e-mail + senha → JWT.")
    Component(loginController,  "LoginController",        "MVC · /login",                      "Página de login Thymeleaf.")

    ' ─── Estoque ─────────────────────────────────────────────────
    Component(estoqueController,"EstoqueController",      "MVC · /, /estoque",                 "Visão consolidada do CD e das lojas.")

    ' ─── Sabores ─────────────────────────────────────────────────
    Component(saborController,  "SaborController",        "MVC · /sabores",                    "Listar (todos); CRUD e inativar (ADMIN).")
    Component(saborService,     "SaborService",           "Service · @Transactional",          "Validação de nome único e status ativo/inativo.")
    Component(saborRepo,        "SaborRepository",        "JpaRepository<Sabor>",              "Persistência de Sabor.")

    ' ─── Lotes ───────────────────────────────────────────────────
    Component(loteController,   "LoteController",         "MVC · /lotes",                      "Listar (todos); criar lote (ADMIN).")
    Component(loteService,      "LoteService",            "Service · @Transactional",          "Saldo disponível do lote; atomicidade.")
    Component(loteRepo,         "LoteProducaoRepository", "JpaRepository<LoteProducao>",       "Persistência de LoteProducao.")

    ' ─── Lojas ───────────────────────────────────────────────────
    Component(lojaController,   "LojaController",         "MVC · /lojas",                      "Listar (todos); CRUD e inativar (ADMIN).")
    Component(lojaService,      "LojaService",            "Service · @Transactional",          "Validação e endereço estruturado.")
    Component(lojaRepo,         "LojaRepository",         "JpaRepository<Loja>",               "Persistência de Loja.")

    ' ─── Distribuição ────────────────────────────────────────────
    Component(distController,   "DistribuicaoController", "MVC · /distribuicoes",              "Listar e registrar (ADMIN/OPERADOR); cancelar (ADMIN).")
    Component(distService,      "DistribuicaoService",    "Service · @Transactional",          "Valida saldo; estorno no cancelamento.")
    Component(distRepo,         "DistribuicaoRepository", "JpaRepository<Distribuicao>",       "Persistência de Distribuicao.")

    ' ─── Baixas ──────────────────────────────────────────────────
    Component(baixaController,  "BaixaEstoqueController", "MVC · /baixas",                     "Registrar baixa e listar histórico (ADMIN/OPERADOR).")
    Component(baixaService,     "BaixaEstoqueService",    "Service · @Transactional",          "Saldo da loja; atomicidade.")
    Component(baixaRepo,        "BaixaEstoqueRepository", "JpaRepository<BaixaEstoque>",      "Persistência de BaixaEstoque.")

    ' ─── Usuários ────────────────────────────────────────────────
    Component(usuarioController,"UsuarioController",      "MVC · /usuarios",                   "CRUD de operadores (ADMIN).")
    Component(usuarioService,   "UsuarioService",         "UserDetailsService",                "Autenticação e cadastro com BCrypt.")
    Component(usuarioRepo,      "UsuarioRepository",      "JpaRepository<Usuario>",            "Persistência de Usuario.")

}

' ─── Pessoas → Controllers ────────────────────────────────────────────────────
Rel(admin,    authController,    "POST /auth/login",              "JSON")
Rel(operador, authController,    "POST /auth/login",              "JSON")
Rel(admin,    estoqueController, "GET /estoque",                  "HTML")
Rel(operador, estoqueController, "GET /estoque",                  "HTML")
Rel(admin,    saborController,   "CRUD /sabores",                 "HTML")
Rel(operador, saborController,   "GET /sabores",                  "HTML")
Rel(admin,    loteController,    "GET/POST /lotes",               "HTML")
Rel(operador, loteController,    "GET /lotes",                    "HTML")
Rel(admin,    lojaController,    "CRUD /lojas",                   "HTML")
Rel(operador, lojaController,    "GET /lojas",                    "HTML")
Rel(admin,    distController,    "GET/POST /distribuicoes",       "HTML")
Rel(operador, distController,    "GET/POST /distribuicoes",       "HTML")
Rel(admin,    baixaController,   "GET/POST /baixas",              "HTML")
Rel(operador, baixaController,   "GET/POST /baixas",              "HTML")
Rel(admin,    usuarioController, "CRUD /usuarios",                "HTML")

' ─── Segurança ────────────────────────────────────────────────────────────────
Rel(jwtFilter,      jwtService,     "Valida token JWT")
Rel(jwtFilter,      usuarioService, "Carrega usuário autenticado")
Rel(authController, usuarioService, "Autentica credenciais")
Rel(authController, jwtService,     "Solicita geração do token")
Rel(securityConfig, jwtFilter,      "Registra filtro na cadeia HTTP")

' ─── Controllers → Services ───────────────────────────────────────────────────
Rel(estoqueController, loteService,   "Consulta saldos")
Rel(estoqueController, baixaService,  "Consulta saldos por loja")
Rel(saborController, saborService,  "Delega regras de negócio")
Rel(loteController,  loteService,   "Delega regras de negócio")
Rel(lojaController,  lojaService,   "Delega regras de negócio")
Rel(distController,  distService,   "Delega regras de negócio")
Rel(baixaController, baixaService,  "Delega regras de negócio")
Rel(usuarioController, usuarioService, "Delega cadastro")

' ─── Services → Repositories ──────────────────────────────────────────────────
Rel(saborService,   saborRepo,   "Lê e escreve", "JPA")
Rel(loteService,    loteRepo,    "Lê e escreve", "JPA")
Rel(lojaService,    lojaRepo,    "Lê e escreve", "JPA")
Rel(distService,    distRepo,    "Lê e escreve", "JPA")
Rel(distService,    loteRepo,    "Atualiza saldo do lote", "JPA")
Rel(baixaService,   baixaRepo,   "Lê e escreve", "JPA")
Rel(baixaService,   distRepo,    "Consulta total recebido pela loja", "JPA")
Rel(usuarioService, usuarioRepo, "Lê e escreve", "JPA")

' ─── Repositories → Banco ─────────────────────────────────────────────────────
Rel(saborRepo,   db, "SQL", "JPA / Hibernate · TCP 3306")
Rel(loteRepo,    db, "SQL", "JPA / Hibernate · TCP 3306")
Rel(lojaRepo,    db, "SQL", "JPA / Hibernate · TCP 3306")
Rel(distRepo,    db, "SQL", "JPA / Hibernate · TCP 3306")
Rel(baixaRepo,   db, "SQL", "JPA / Hibernate · TCP 3306")
Rel(usuarioRepo, db, "SQL", "JPA / Hibernate · TCP 3306")

@enduml
