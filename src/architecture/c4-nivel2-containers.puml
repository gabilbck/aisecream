@startuml c4-containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title Diagrama de Containers — Aí 'Se Cream (C4 Nível 2)

Person(admin, "Administrador", "Gerencia sabores, lojas, lotes, distribuições, baixas e operadores.")
Person(operador, "Operador de Produção", "Visualiza o sistema (exceto operadores). Registra distribuições e baixas de estoque.")

System_Boundary(aisecream, "Aí 'Se Cream") {

    Container(web, "Aplicação Web", "Java 21 · Spring Boot 4 · Spring MVC · Thymeleaf", "Renderiza páginas HTML server-side. Contém Controllers, Services e Repositories. Aplica regras de negócio (validação de saldo, atomicidade).")

    Container(security, "Módulo de Segurança", "Spring Security · JWT", "Autentica usuários via e-mail e senha. Emite e valida tokens JWT em cookie HTTP-only. RBAC por perfil (ADMIN / OPERADOR).")

    ContainerDb(db, "Banco de Dados", "MariaDB", "Armazena sabores, lotes, lojas, distribuições, baixas e usuários. Schema versionado pelo Flyway.")

}

Rel(admin, web, "Utiliza via navegador", "HTTPS / HTML")
Rel(operador, web, "Utiliza via navegador", "HTTPS / HTML")

Rel(web, security, "Delega autenticação e autorização")
Rel(security, web, "Retorna identidade e perfil do usuário autenticado")

Rel(web, db, "Lê e escreve dados", "JPA / Hibernate · TCP 3306")

@enduml
